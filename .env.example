# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_api_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres

# CSV Output Directory
CSV_OUTPUT_DIR=./output

# Langfuse Observability Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-multi-agent-system
LANGFUSE_SECRET_KEY=sk-lf-multi-agent-system
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_ADMIN_EMAIL=admin@local.internal
LANGFUSE_ADMIN_PASSWORD=password123

